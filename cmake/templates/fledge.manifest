<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded into every Fledge exe by cmake/templates/version.rc.in. longPathAware lets the Win32 file APIs take
     paths over MAX_PATH (260) when the system allows it (LongPathsEnabled); the engine additionally uses the \\?\ form
     (fledge::osPath) so long paths work either way. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <ws2:longPathAware>true</ws2:longPathAware>
    </windowsSettings>
  </application>
</assembly>
