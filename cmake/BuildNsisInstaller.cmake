# cmake -DBUILD_DIR=... -DSOURCE_DIR=... -DVERSION=... -DCMAKE_COMMAND_PATH=... -P BuildNsisInstaller.cmake
#
# 1. Fetches NSIS 3.10 (zip build, no installer) into <build>/_tools - pinned by SHA256.
#    Nothing is installed system-wide; the zip is extracted into the build tree only.
# 2. Stages `cmake --install` into <build>/_installer/stage.
# 3. Compiles installer/fledge.nsi -> <build>/dist/Fledge-<version>-setup.exe.
cmake_minimum_required(VERSION 3.24)
if(DEFINED EDITION AND NOT EDITION STREQUAL "Standard")
  message(FATAL_ERROR "This source distribution supports only Fledge Standard")
endif()

set(NSIS_VERSION 3.10)
set(NSIS_URL "https://downloads.sourceforge.net/project/nsis/NSIS%203/3.10/nsis-3.10.zip")
set(NSIS_SHA256 fcdce3229717a2a148e7cda0ab5bdb667f39d8fb33ede1da8dabc336bd5ad110)

set(_tools ${BUILD_DIR}/_tools)
set(_zip ${_tools}/nsis-${NSIS_VERSION}.zip)
set(_nsis_root ${_tools}/nsis)
set(_makensis ${_nsis_root}/nsis-${NSIS_VERSION}/makensis.exe)
file(MAKE_DIRECTORY ${_tools})

set(_have "")
if(EXISTS ${_zip})
  file(SHA256 ${_zip} _have)
endif()
if(NOT _have STREQUAL NSIS_SHA256)
  message(STATUS "Downloading NSIS ${NSIS_VERSION} (zip, pinned SHA256)")
  file(DOWNLOAD ${NSIS_URL} ${_zip}.part STATUS _st)
  list(GET _st 0 _code)
  if(NOT _code EQUAL 0)
    file(REMOVE ${_zip}.part)
    message(FATAL_ERROR "NSIS download failed: ${_st}")
  endif()
  file(SHA256 ${_zip}.part _have)
  if(NOT _have STREQUAL NSIS_SHA256)
    file(REMOVE ${_zip}.part)
    message(FATAL_ERROR "NSIS zip hash mismatch: got ${_have}, expected ${NSIS_SHA256}")
  endif()
  file(RENAME ${_zip}.part ${_zip})
  file(REMOVE_RECURSE ${_nsis_root})
endif()
if(NOT EXISTS ${_makensis})
  file(REMOVE_RECURSE ${_nsis_root})
  file(ARCHIVE_EXTRACT INPUT ${_zip} DESTINATION ${_nsis_root})
endif()
if(NOT EXISTS ${_makensis})
  message(FATAL_ERROR "makensis.exe not found after extracting ${_zip}")
endif()

# Stage the relocatable install tree.
set(_stage ${BUILD_DIR}/_installer/stage)
file(REMOVE_RECURSE ${_stage})
execute_process(COMMAND ${CMAKE_COMMAND_PATH} --install ${BUILD_DIR} --prefix ${_stage} RESULT_VARIABLE _rc OUTPUT_QUIET)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "cmake --install failed (${_rc})")
endif()

file(MAKE_DIRECTORY ${BUILD_DIR}/dist)
if(NOT EDITION)
  set(EDITION Standard)
endif()
if(NOT PACKAGE_NAME)
  set(PACKAGE_NAME Fledge)
endif()
set(_out ${BUILD_DIR}/dist/${PACKAGE_NAME}-${VERSION}-setup.exe)
file(TO_NATIVE_PATH ${_stage} _stage_n)
file(TO_NATIVE_PATH ${_out} _out_n)
file(TO_NATIVE_PATH ${SOURCE_DIR}/installer/fledge.nsi _nsi_n)
execute_process(COMMAND ${_makensis} /V2 /INPUTCHARSET UTF8 /DVERSION=${VERSION} /DEDITION=${EDITION} /DSTAGE=${_stage_n} /DOUTFILE=${_out_n} ${_nsi_n}
                RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "makensis failed (${_rc})")
endif()
file(SIZE ${_out} _size)
math(EXPR _kib "${_size} / 1024")
message(STATUS "Installer: ${_out} (${_kib} KiB)")
