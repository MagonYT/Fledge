# Editor resources (fonts, icons), generated headers, Windows version
# resources and the build-tree path manifest (bin/fledge_paths.json).

set(FLEDGE_RESOURCES_BUILD_DIR ${CMAKE_BINARY_DIR}/resources)
file(MAKE_DIRECTORY ${FLEDGE_RESOURCES_BUILD_DIR}/fonts ${FLEDGE_RESOURCES_BUILD_DIR}/icons)

# --- version header -----------------------------------------------------------
configure_file(${CMAKE_SOURCE_DIR}/cmake/templates/version.h.in ${CMAKE_BINARY_DIR}/generated/fledge/core/version.h @ONLY)

# --- icons (generated by tools/scripts/make_icons.py, committed) --------------
foreach(_ico fledge.ico fledge_project.ico fledge_256.png)
  configure_file(${CMAKE_SOURCE_DIR}/resources/icons/${_ico} ${FLEDGE_RESOURCES_BUILD_DIR}/icons/${_ico} COPYONLY)
endforeach()

# --- fonts -----------------------------------------------------------------------
# Roboto Medium (Apache-2.0) is the default in-game UI font. Cousine ships with the editor.
# Copy from Dear ImGui when the editor is built; otherwise fetch the same file (SHA256-pinned).
set(_roboto ${FLEDGE_RESOURCES_BUILD_DIR}/fonts/Roboto-Medium.ttf)
set(_roboto_sha 8559132c89ad51d8a2ba5b171887a44a7ba93776e205f553573de228e64b45f8)
if(FLEDGE_BUILD_EDITOR)
  configure_file(${imgui_SOURCE_DIR}/misc/fonts/Roboto-Medium.ttf ${_roboto} COPYONLY)
  configure_file(${imgui_SOURCE_DIR}/misc/fonts/Cousine-Regular.ttf ${FLEDGE_RESOURCES_BUILD_DIR}/fonts/Cousine-Regular.ttf COPYONLY)
endif()
if(FLEDGE_BUILD_EDITOR)
  # Font Awesome Free 6.5.2 solid icon font (font: OFL-1.1, icons: CC BY 4.0), SHA256-pinned.
  # The download is skipped when the file is already present with the right hash.
  set(_fa ${FLEDGE_RESOURCES_BUILD_DIR}/fonts/fa-solid-900.ttf)
  set(_fa_sha 4312f534f4fc39b771774db6a5a00e22992437d8707a02ce163b4e47e432e65c)
  set(_fa_ok FALSE)
  if(EXISTS ${_fa})
    file(SHA256 ${_fa} _have)
    if(_have STREQUAL _fa_sha)
      set(_fa_ok TRUE)
    endif()
  endif()
  if(NOT _fa_ok)
    # Integrity comes from the pinned SHA256 (checked below), like the other pinned archives.
    file(DOWNLOAD https://raw.githubusercontent.com/FortAwesome/Font-Awesome/6.5.2/webfonts/fa-solid-900.ttf ${_fa}.part
         STATUS _st)
    list(GET _st 0 _code)
    set(_have "")
    if(_code EQUAL 0)
      file(SHA256 ${_fa}.part _have)
    endif()
    if(_have STREQUAL _fa_sha)
      file(RENAME ${_fa}.part ${_fa})
    else()
      file(REMOVE ${_fa}.part)
      message(WARNING "Font Awesome download failed or hash mismatch (${_st}); the editor falls back to text-only buttons.")
    endif()
  endif()
endif()

# fledge_fetch_pinned(<url> <dest> <sha256> <ok-var>): download once, verify the pinned hash.
function(fledge_fetch_pinned url dest sha okvar)
  set(_ok FALSE)
  if(EXISTS ${dest})
    file(SHA256 ${dest} _have)
    if(_have STREQUAL sha)
      set(_ok TRUE)
    endif()
  endif()
  if(NOT _ok)
    file(DOWNLOAD ${url} ${dest}.part STATUS _st)
    list(GET _st 0 _code)
    set(_have "")
    if(_code EQUAL 0)
      file(SHA256 ${dest}.part _have)
    endif()
    if(_have STREQUAL sha)
      file(RENAME ${dest}.part ${dest})
      set(_ok TRUE)
    else()
      file(REMOVE ${dest}.part)
      message(WARNING "Download failed or hash mismatch: ${url} (${_st})")
    endif()
  endif()
  set(${okvar} ${_ok} PARENT_SCOPE)
endfunction()

if(NOT FLEDGE_BUILD_EDITOR)
  fledge_fetch_pinned(https://raw.githubusercontent.com/ocornut/imgui/v1.91.9b-docking/misc/fonts/Roboto-Medium.ttf
                      ${_roboto} ${_roboto_sha} _roboto_ok)
  if(NOT _roboto_ok)
    message(WARNING "Roboto-Medium.ttf is missing; in-game UI falls back to the pixel font.")
  endif()
endif()

if(FLEDGE_BUILD_EDITOR)
  # JetBrains Mono 2.304 Regular (OFL-1.1): the Code workspace font.
  fledge_fetch_pinned(https://raw.githubusercontent.com/JetBrains/JetBrainsMono/v2.304/fonts/ttf/JetBrainsMono-Regular.ttf
                      ${FLEDGE_RESOURCES_BUILD_DIR}/fonts/JetBrainsMono-Regular.ttf
                      a0bf60ef0f83c5ed4d7a75d45838548b1f6873372dfac88f71804491898d138f _jbm_ok)
  # clangd 23.1.0 (Apache-2.0 WITH LLVM-exception) for the Code workspace language features. Only clangd.exe,
  # the builtin headers and the licence are kept (resources/clangd/). FLEDGE_FETCH_CLANGD=OFF skips it;
  # the editor then uses clangd from PATH or its basic symbol index.
  option(FLEDGE_FETCH_CLANGD "Download the pinned clangd release for the Code workspace" ON)
  set(_cd_dir ${FLEDGE_RESOURCES_BUILD_DIR}/clangd)
  if(FLEDGE_FETCH_CLANGD AND NOT EXISTS ${_cd_dir}/bin/clangd.exe)
    set(_cd_zip ${CMAKE_BINARY_DIR}/_deps/clangd-windows-23.1.0.zip)
    fledge_fetch_pinned(https://github.com/clangd/clangd/releases/download/23.1.0/clangd-windows-23.1.0.zip ${_cd_zip}
                        23412a240756a162e7b98a282f36aa2a23a88db5ce16a0cbc4fef7253768c810 _cd_ok)
    if(_cd_ok)
      set(_cd_tmp ${CMAKE_BINARY_DIR}/_deps/clangd_extract)
      file(REMOVE_RECURSE ${_cd_tmp})
      file(ARCHIVE_EXTRACT INPUT ${_cd_zip} DESTINATION ${_cd_tmp}
           PATTERNS clangd_23.1.0/bin/clangd.exe clangd_23.1.0/lib/clang/23/include clangd_23.1.0/LICENSE.TXT)
      file(COPY ${_cd_tmp}/clangd_23.1.0/bin ${_cd_tmp}/clangd_23.1.0/lib DESTINATION ${_cd_dir})
      file(COPY ${_cd_tmp}/clangd_23.1.0/LICENSE.TXT DESTINATION ${_cd_dir})
      file(REMOVE_RECURSE ${_cd_tmp})
    endif()
  endif()
endif()

# --- build-tree path manifest -------------------------------------------------------
# Relative to bin/, so the build tree itself contains no absolute paths in it either.
set(_bin ${CMAKE_BINARY_DIR}/bin)
file(MAKE_DIRECTORY ${_bin})
function(_fledge_rel out path)
  file(RELATIVE_PATH _r ${CMAKE_BINARY_DIR}/bin ${path})
  if(_r STREQUAL "")
    set(_r ".")
  endif()
  set(${out} ${_r} PARENT_SCOPE)
endfunction()
_fledge_rel(_root ${CMAKE_SOURCE_DIR})
_fledge_rel(_res ${FLEDGE_RESOURCES_BUILD_DIR})
_fledge_rel(_tpl ${CMAKE_SOURCE_DIR}/templates)
_fledge_rel(_smp ${CMAKE_SOURCE_DIR}/samples)
_fledge_rel(_doc ${CMAKE_SOURCE_DIR}/docs)
_fledge_rel(_lic ${CMAKE_SOURCE_DIR}/licenses)
_fledge_rel(_sdk ${CMAKE_SOURCE_DIR}/engine/scripting/sdk)
# Development builds keep their user data (settings, shader caches, upscaler downloads) inside the
# build tree, so running tools from a build never touches %APPDATA%.
_fledge_rel(_ud ${CMAKE_BINARY_DIR}/UserData)
file(WRITE ${_bin}/fledge_paths.json.tmp
"{\n  \"comment\": \"Build-tree layout for fledge tools (generated by CMake, not installed)\",\n  \"root\": \"${_root}\",\n  \"resources\": \"${_res}\",\n  \"templates\": \"${_tpl}\",\n  \"samples\": \"${_smp}\",\n  \"docs\": \"${_doc}\",\n  \"licenses\": \"${_lic}\",\n  \"sdk\": \"${_sdk}\",\n  \"userData\": \"${_ud}\"\n}\n")
configure_file(${_bin}/fledge_paths.json.tmp ${_bin}/fledge_paths.json COPYONLY)
file(REMOVE ${_bin}/fledge_paths.json.tmp)

# --- Windows version resources + icon ------------------------------------------------------
# fledge_add_version_resource(<target> "<description>" [ICON <file.ico>])
function(fledge_add_version_resource target description)
  if(NOT WIN32)
    return()
  endif()
  cmake_parse_arguments(ARG "" "ICON" "" ${ARGN})
  if(NOT ARG_ICON)
    set(ARG_ICON ${CMAKE_SOURCE_DIR}/resources/icons/fledge.ico)
  endif()
  set(FLEDGE_RC_ICON ${ARG_ICON})
  set(FLEDGE_RC_MANIFEST ${CMAKE_SOURCE_DIR}/cmake/templates/fledge.manifest)
  set(FLEDGE_RC_DESCRIPTION ${description})
  set(FLEDGE_RC_NAME ${target})
  set(FLEDGE_RC_PRODUCT "Fledge Engine")
  set(_rc ${CMAKE_BINARY_DIR}/generated/rc/${target}.rc)
  configure_file(${CMAKE_SOURCE_DIR}/cmake/templates/version.rc.in ${_rc} @ONLY)
  target_sources(${target} PRIVATE ${_rc})
endfunction()
