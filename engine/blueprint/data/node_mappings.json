{
  "version": 1,
  "comment": "Unreal Blueprint -> Fledge Script mapping table (docs/BLUEPRINT_CONVERTER.md). Templates: ${Pin} = the input pin converted to the type in args (any = the pin's own type), ${self} = the target entity (GetEntity() when the self pin is unlinked), ${ref:Pin} = an assignable expression for the pin, ${member:Pin} = the member that stores an impure node's output. status: converted | approximated | stubbed.",
  "events": [
    {"name": "ReceiveBeginPlay", "callback": "OnStart", "title": "BeginPlay"},
    {"name": "ReceiveTick", "callback": "OnUpdate", "title": "Tick", "args": {"DeltaSeconds": "dt"}},
    {"name": "ReceiveEndPlay", "callback": "OnDestroy", "title": "EndPlay", "status": "approximated", "note": "EndPlayReason is always Destroyed (0)", "args": {"EndPlayReason": "0"}},
    {"name": "ReceiveDestroyed", "callback": "OnDestroy", "title": "Destroyed"},
    {"name": "ReceiveActorBeginOverlap", "callback": "OnTriggerEnter", "title": "ActorBeginOverlap", "note": "needs a Collider with isTrigger on the entity", "args": {"OtherActor": "other"}},
    {"name": "ReceiveActorEndOverlap", "callback": "OnTriggerExit", "title": "ActorEndOverlap", "note": "needs a Collider with isTrigger on the entity", "args": {"OtherActor": "other"}},
    {"name": "ReceiveHit", "callback": "OnCollisionEnter", "title": "Hit", "status": "approximated", "note": "Collision.point / normal are not filled in by Fledge yet; MyComp / OtherComp are the entities", "args": {"Other": "c.other", "OtherComp": "c.other", "MyComp": "GetEntity()", "HitLocation": "bp::PosToUE(c.point)", "HitNormal": "bp::DirToUE(c.normal)", "bSelfMoved": "true"}},
    {"name": "OnComponentBeginOverlap", "callback": "OnTriggerEnter", "title": "ComponentBeginOverlap", "status": "approximated", "note": "component events fire for the whole entity", "args": {"OtherActor": "other", "OtherComp": "other", "OverlappedComponent": "GetEntity()"}},
    {"name": "OnComponentEndOverlap", "callback": "OnTriggerExit", "title": "ComponentEndOverlap", "status": "approximated", "note": "component events fire for the whole entity", "args": {"OtherActor": "other", "OtherComp": "other", "OverlappedComponent": "GetEntity()"}},
    {"name": "OnComponentHit", "callback": "OnCollisionEnter", "title": "ComponentHit", "status": "approximated", "note": "component events fire for the whole entity", "args": {"OtherActor": "c.other", "OtherComp": "c.other", "HitComponent": "GetEntity()", "NormalImpulse": "Vec3()"}},
    {"name": "ReceiveAnyDamage", "callback": "", "title": "AnyDamage", "status": "stubbed", "note": "Fledge has no damage events: the function is generated but nothing calls it (call it from your Health logic)"},
    {"name": "ReceivePossessed", "callback": "", "title": "Possessed", "status": "stubbed", "note": "no possession in Fledge"},
    {"name": "ReceiveUnpossessed", "callback": "", "title": "Unpossessed", "status": "stubbed", "note": "no possession in Fledge"},
    {"name": "ReceiveActorOnClicked", "callback": "", "title": "ActorOnClicked", "status": "stubbed", "note": "no mouse picking events in Fledge Script"},
    {"name": "UserConstructionScript", "callback": "OnCreate", "title": "ConstructionScript", "status": "approximated", "note": "runs when the behaviour is created (not in the editor)"}
  ],
  "inputActions": {"Jump": "Jump", "Fire": "Fire", "Interact": "Interact", "Use": "Interact", "Sprint": "Sprint", "Run": "Sprint", "Aim": "Aim", "Crouch": "Crouch", "Reload": "Reload", "Pause": "Pause", "Menu": "Pause", "PrimaryAction": "Fire", "SecondaryAction": "Aim", "Move": "MoveY", "Look": "LookX"},
  "inputAxes": {"MoveForward": "MoveY", "MoveRight": "MoveX", "Turn": "LookX", "TurnRate": "LookX", "LookUp": "LookY", "LookUpRate": "LookY", "MoveX": "MoveX", "MoveY": "MoveY", "Forward": "MoveY", "Right": "MoveX"},
  "keys": {"SpaceBar": "Space", "Enter": "Enter", "Escape": "Escape", "Tab": "Tab", "BackSpace": "Backspace", "LeftShift": "LeftShift", "RightShift": "RightShift", "LeftControl": "LeftControl", "RightControl": "RightControl", "LeftAlt": "LeftAlt", "RightAlt": "RightAlt", "LeftMouseButton": "MouseLeft", "RightMouseButton": "MouseRight", "MiddleMouseButton": "MouseMiddle", "Up": "Up", "Down": "Down", "Left": "Left", "Right": "Right", "Zero": "0", "One": "1", "Two": "2", "Three": "3", "Four": "4", "Five": "5", "Six": "6", "Seven": "7", "Eight": "8", "Nine": "9", "Gamepad_FaceButton_Bottom": "PadA", "Gamepad_FaceButton_Right": "PadB", "Gamepad_FaceButton_Left": "PadX", "Gamepad_FaceButton_Top": "PadY", "Gamepad_Special_Right": "PadStart"},
  "functions": [
    {"name": "PrintString", "stmt": "Log::Info(\"{}\", ${InString});", "args": {"InString": "string"}, "note": "screen output, colour and duration are ignored; the text goes to the Output panel / get_runtime_log"},
    {"name": "PrintText", "stmt": "Log::Info(\"{}\", ${InText});", "args": {"InText": "string"}, "note": "screen output is ignored"},
    {"name": "PrintWarning", "stmt": "Log::Warn(\"{}\", ${InString});", "args": {"InString": "string"}},
    {"name": "Delay", "handler": "delay", "args": {"Duration": "float"}},
    {"name": "RetriggerableDelay", "handler": "retriggerable_delay", "args": {"Duration": "float"}},
    {"name": "DelayUntilNextTick", "handler": "next_tick"},
    {"name": "K2_SetTimer", "handler": "timer_by_name", "args": {"FunctionName": "string", "Time": "float", "bLooping": "bool"}, "status": "approximated", "note": "the function must be a custom event / function without parameters in the same input"},
    {"name": "K2_SetTimerDelegate", "handler": "timer_by_event", "args": {"Time": "float", "bLooping": "bool"}},
    {"name": "K2_ClearTimerHandle", "stmt": "CancelTimer(${Handle});", "args": {"Handle": "timer"}},
    {"name": "K2_ClearAndInvalidateTimerHandle", "stmt": "CancelTimer(${Handle});", "args": {"Handle": "timer"}},
    {"name": "K2_ClearTimer", "handler": "clear_timer_by_name", "args": {"FunctionName": "string"}},
    {"name": "IsValid", "pure": true, "expr": "bp::IsValid(${Object})", "args": {"Object": "any"}},
    {"name": "IsValidClass", "pure": true, "expr": "!(${Class}).empty()", "args": {"Class": "class"}},
    {"name": "GetDisplayName", "pure": true, "expr": "(${Object}).Name()", "args": {"Object": "entity"}},
    {"name": "GetObjectName", "pure": true, "expr": "(${Object}).Name()", "args": {"Object": "entity"}},
    {"name": "GetActorLabel", "pure": true, "expr": "(${self}).Name()"},
    {"name": "QuitGame", "stmt": "Log::Warn(\"{}\", std::string(\"QuitGame requested (not available in Fledge Script)\"));", "status": "stubbed", "note": "no quit API in Fledge Script"},

    {"name": "K2_GetActorLocation", "pure": true, "expr": "bp::PosToUE((${self}).Position())"},
    {"name": "K2_SetActorLocation", "stmt": "(${self}).SetPosition(bp::PosFromUE(${NewLocation}));", "args": {"NewLocation": "vector"}, "outputs": {"ReturnValue": "true"}, "outTypes": {"ReturnValue": "bool"}, "note": "sweep / teleport are ignored"},
    {"name": "K2_GetActorRotation", "pure": true, "expr": "bp::QuatToRotator((${self}).Rotation())"},
    {"name": "K2_SetActorRotation", "stmt": "(${self}).SetRotation(bp::RotatorToQuat(${NewRotation}));", "args": {"NewRotation": "rotator"}, "outputs": {"ReturnValue": "true"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "K2_SetActorLocationAndRotation", "stmt": "(${self}).SetPosition(bp::PosFromUE(${NewLocation})); (${self}).SetRotation(bp::RotatorToQuat(${NewRotation}));", "args": {"NewLocation": "vector", "NewRotation": "rotator"}, "outputs": {"ReturnValue": "true"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "K2_AddActorWorldOffset", "stmt": "(${self}).Translate(bp::PosFromUE(${DeltaLocation}));", "args": {"DeltaLocation": "vector"}, "note": "sweep / teleport are ignored"},
    {"name": "K2_AddActorLocalOffset", "stmt": "(${self}).Translate((${self}).Rotation().Rotate(bp::PosFromUE(${DeltaLocation})));", "args": {"DeltaLocation": "vector"}, "note": "sweep / teleport are ignored"},
    {"name": "K2_AddActorWorldRotation", "stmt": "(${self}).Rotate(bp::RotatorToQuat(${DeltaRotation}));", "args": {"DeltaRotation": "rotator"}},
    {"name": "K2_AddActorLocalRotation", "stmt": "(${self}).SetRotation((${self}).Rotation() * bp::RotatorToQuat(${DeltaRotation}));", "args": {"DeltaRotation": "rotator"}},
    {"name": "K2_SetActorRelativeLocation", "stmt": "(${self}).SetLocalPosition(bp::PosFromUE(${NewRelativeLocation}));", "args": {"NewRelativeLocation": "vector"}},
    {"name": "K2_TeleportTo", "stmt": "(${self}).SetPosition(bp::PosFromUE(${DestLocation})); (${self}).SetRotation(bp::RotatorToQuat(${DestRotation}));", "args": {"DestLocation": "vector", "DestRotation": "rotator"}, "outputs": {"ReturnValue": "true"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "K2_DestroyActor", "stmt": "(${self}).Destroy();"},
    {"name": "K2_DestroyComponent", "stmt": "(${self}).Destroy();", "status": "approximated", "note": "components are entities in Fledge: the whole entity is destroyed"},
    {"name": "GetActorForwardVector", "pure": true, "expr": "bp::DirToUE((${self}).Forward())"},
    {"name": "GetActorRightVector", "pure": true, "expr": "bp::DirToUE((${self}).Right())"},
    {"name": "GetActorUpVector", "pure": true, "expr": "bp::DirToUE((${self}).Up())"},
    {"name": "GetActorScale3D", "pure": true, "expr": "bp::ScaleToUE((${self}).Scale())"},
    {"name": "SetActorScale3D", "stmt": "(${self}).SetScale(bp::ScaleFromUE(${NewScale3D}));", "args": {"NewScale3D": "vector"}},
    {"name": "SetActorHiddenInGame", "stmt": "(${self}).SetVisible(!(${bNewHidden}));", "args": {"bNewHidden": "bool"}},
    {"name": "SetVisibility", "stmt": "(${self}).SetVisible(${bNewVisibility});", "args": {"bNewVisibility": "bool"}, "status": "approximated", "note": "applies to the entity's MeshRenderer"},
    {"name": "SetHiddenInGame", "stmt": "(${self}).SetVisible(!(${NewHidden}));", "args": {"NewHidden": "bool"}, "status": "approximated", "note": "applies to the entity's MeshRenderer"},
    {"name": "GetDistanceTo", "pure": true, "expr": "(Vec3::Distance((${self}).Position(), (${OtherActor}).Position()) * bp::kUnitsPerMeter)", "args": {"OtherActor": "entity"}},
    {"name": "ActorHasTag", "pure": true, "expr": "(${self}).HasTag(${Tag})", "args": {"Tag": "string"}},
    {"name": "ComponentHasTag", "pure": true, "expr": "(${self}).HasTag(${Tag})", "args": {"Tag": "string"}, "status": "approximated"},
    {"name": "GetOwner", "pure": true, "expr": "(${self}).Parent()", "status": "approximated", "note": "the parent entity"},
    {"name": "K2_AttachToActor", "stmt": "(${self}).SetParent(${ParentActor});", "args": {"ParentActor": "entity"}, "status": "approximated", "note": "socket and attachment rules are ignored (keeps the world transform)"},
    {"name": "K2_DetachFromActor", "stmt": "(${self}).SetParent(Entity());", "status": "approximated"},
    {"name": "SetActorTickEnabled", "stmt": "SetEnabled(${bEnabled});", "args": {"bEnabled": "bool"}, "status": "approximated", "note": "disables the whole behaviour"},
    {"name": "GetComponentByClass", "pure": true, "expr": "(${self})", "status": "approximated", "note": "components are the entity's own components in Fledge: the entity is returned"},

    {"name": "GetWorldDeltaSeconds", "pure": true, "expr": "Time::Delta()"},
    {"name": "GetGameTimeInSeconds", "pure": true, "expr": "static_cast<float>(Time::Elapsed())"},
    {"name": "GetTimeSeconds", "pure": true, "expr": "static_cast<float>(Time::Elapsed())"},
    {"name": "GetRealTimeSeconds", "pure": true, "expr": "static_cast<float>(Time::Elapsed())", "status": "approximated", "note": "scaled time"},
    {"name": "SetGlobalTimeDilation", "stmt": "Time::SetScale(${TimeDilation});", "args": {"TimeDilation": "float"}},
    {"name": "GetGlobalTimeDilation", "pure": true, "expr": "Time::Scale()"},
    {"name": "SetGamePaused", "stmt": "Time::SetScale((${bPaused}) ? 0.0f : 1.0f);", "args": {"bPaused": "bool"}, "status": "approximated", "note": "time scale 0"},
    {"name": "GetPlayerPawn", "pure": true, "expr": "Gameplay::Player()", "status": "approximated", "note": "the entity with the PlayerController component"},
    {"name": "GetPlayerCharacter", "pure": true, "expr": "Gameplay::Player()", "status": "approximated", "note": "the entity with the PlayerController component"},
    {"name": "GetPlayerController", "pure": true, "expr": "Gameplay::Player()", "status": "approximated", "note": "Fledge has no controllers: the player entity"},
    {"name": "GetController", "pure": true, "expr": "(${self})", "status": "approximated", "note": "Fledge has no controllers"},
    {"name": "GetAllActorsWithTag", "stmt": "${member:OutActors} = Scene::FindAllWithTag((${Tag}).c_str());", "args": {"Tag": "string"}},
    {"name": "GetAllActorsOfClass", "stmt": "${member:OutActors} = Scene::FindAllWithTag(bp::ClassTag(${ActorClass}).c_str());", "args": {"ActorClass": "class"}, "status": "approximated", "note": "Fledge has no actor classes: finds the entities tagged with the class name"},
    {"name": "GetActorOfClass", "pure": true, "expr": "Scene::FindWithTag(bp::ClassTag(${ActorClass}).c_str())", "args": {"ActorClass": "class"}, "status": "approximated", "note": "finds an entity tagged with the class name"},
    {"name": "PlaySoundAtLocation", "stmt": "Audio::PlayOneShot(bp::AssetPath(${Sound}).c_str(), bp::PosFromUE(${Location}), ${VolumeMultiplier});", "args": {"Sound": "asset", "Location": "vector", "VolumeMultiplier": "float"}, "status": "approximated", "note": "the sound asset is looked up as Audio/<name>.wav; pitch / attenuation ignored"},
    {"name": "PlaySound2D", "stmt": "Audio::PlayOneShot(bp::AssetPath(${Sound}).c_str(), Vec3(), ${VolumeMultiplier}, \"UI\", false);", "args": {"Sound": "asset", "VolumeMultiplier": "float"}, "status": "approximated", "note": "the sound asset is looked up as Audio/<name>.wav"},
    {"name": "SpawnSoundAtLocation", "stmt": "Audio::PlayOneShot(bp::AssetPath(${Sound}).c_str(), bp::PosFromUE(${Location}), ${VolumeMultiplier});", "args": {"Sound": "asset", "Location": "vector", "VolumeMultiplier": "float"}, "status": "approximated", "note": "no audio component is returned"},
    {"name": "OpenLevel", "stmt": "Log::Warn(\"OpenLevel '{}' is not available in Fledge Script\", ${LevelName});", "args": {"LevelName": "string"}, "status": "stubbed", "note": "load scenes with the Fledge scene API / Mission flow instead"},

    {"name": "Jump", "stmt": "CharacterController(${self}).Jump();", "note": "needs a CharacterController component"},
    {"name": "StopJumping", "stmt": "(void)0;", "status": "approximated", "note": "Fledge jumps are impulses: nothing to stop"},
    {"name": "AddMovementInput", "handler": "movement", "args": {"WorldDirection": "vector", "ScaleValue": "float"}, "status": "approximated", "note": "accumulated per frame and applied with CharacterController::Move at bp::kWalkSpeed (6 m/s); needs a CharacterController"},
    {"name": "AddControllerYawInput", "stmt": "(${self}).Rotate(Quat::FromAxisAngle(Vec3::Up(), Radians(-(${Val}))));", "args": {"Val": "float"}, "status": "approximated", "note": "turns the entity by Val degrees"},
    {"name": "AddControllerPitchInput", "stmt": "(void)(${Val});", "args": {"Val": "float"}, "status": "stubbed", "note": "no controller pitch in Fledge: use a CameraRig"},
    {"name": "LaunchCharacter", "stmt": "RigidBody(${self}).AddImpulse(bp::PosFromUE(${LaunchVelocity}));", "args": {"LaunchVelocity": "vector"}, "status": "approximated", "note": "an impulse on the RigidBody"},
    {"name": "PlayAnimMontage", "stmt": "Animator(${self}).Play(bp::AssetName(${AnimMontage}).c_str(), 0.2f);", "args": {"AnimMontage": "asset"}, "outputs": {"ReturnValue": "0.0f"}, "outTypes": {"ReturnValue": "float"}, "status": "approximated", "note": "plays the Animator state named like the montage"},
    {"name": "StopAnimMontage", "stmt": "(void)0;", "status": "stubbed", "note": "no montage slots in Fledge"},
    {"name": "Montage_Play", "stmt": "Animator(${self}).Play(bp::AssetName(${MontageToPlay}).c_str(), 0.2f);", "args": {"MontageToPlay": "asset"}, "outputs": {"ReturnValue": "0.0f"}, "outTypes": {"ReturnValue": "float"}, "status": "approximated", "note": "plays the Animator state named like the montage"},
    {"name": "SetSimulatePhysics", "stmt": "RigidBody(${self}).SetKinematic(!(${bSimulate}));", "args": {"bSimulate": "bool"}, "status": "approximated"},
    {"name": "AddImpulse", "stmt": "RigidBody(${self}).AddImpulse(bp::PosFromUE(${Impulse}));", "args": {"Impulse": "vector"}, "status": "approximated", "note": "units converted like positions"},
    {"name": "AddForce", "stmt": "RigidBody(${self}).AddForce(bp::PosFromUE(${Force}));", "args": {"Force": "vector"}, "status": "approximated", "note": "units converted like positions"},
    {"name": "SetPhysicsLinearVelocity", "stmt": "RigidBody(${self}).SetVelocity(bp::PosFromUE(${NewVel}));", "args": {"NewVel": "vector"}},
    {"name": "GetPhysicsLinearVelocity", "pure": true, "expr": "bp::PosToUE(RigidBody(${self}).Velocity())"},
    {"name": "GetVelocity", "pure": true, "expr": "bp::PosToUE(RigidBody(${self}).Velocity())", "status": "approximated", "note": "RigidBody velocity"},

    {"name": "Add_DoubleDouble", "aliases": ["Add_FloatFloat"], "pure": true, "op": "+", "args": {"A": "float", "B": "float"}},
    {"name": "Subtract_DoubleDouble", "aliases": ["Subtract_FloatFloat"], "pure": true, "expr": "(${A} - ${B})", "args": {"A": "float", "B": "float"}},
    {"name": "Multiply_DoubleDouble", "aliases": ["Multiply_FloatFloat"], "pure": true, "op": "*", "args": {"A": "float", "B": "float"}},
    {"name": "Divide_DoubleDouble", "aliases": ["Divide_FloatFloat"], "pure": true, "expr": "bp::Div(${A}, ${B})", "args": {"A": "float", "B": "float"}, "note": "division by zero gives 0 like Unreal"},
    {"name": "Percent_FloatFloat", "aliases": ["FMod"], "pure": true, "expr": "bp::FMod(${A}, ${B})", "args": {"A": "float", "B": "float"}},
    {"name": "Add_IntInt", "pure": true, "op": "+", "args": {"A": "int", "B": "int"}},
    {"name": "Subtract_IntInt", "pure": true, "expr": "(${A} - ${B})", "args": {"A": "int", "B": "int"}},
    {"name": "Multiply_IntInt", "pure": true, "op": "*", "args": {"A": "int", "B": "int"}},
    {"name": "Divide_IntInt", "pure": true, "expr": "bp::DivInt(${A}, ${B})", "args": {"A": "int", "B": "int"}, "note": "division by zero gives 0 like Unreal"},
    {"name": "Percent_IntInt", "pure": true, "expr": "bp::ModInt(${A}, ${B})", "args": {"A": "int", "B": "int"}},
    {"name": "Multiply_IntFloat", "pure": true, "expr": "(static_cast<float>(${A}) * ${B})", "args": {"A": "int", "B": "float"}},
    {"name": "Add_Int64Int64", "pure": true, "op": "+", "args": {"A": "int64", "B": "int64"}},
    {"name": "Greater_DoubleDouble", "aliases": ["Greater_FloatFloat"], "pure": true, "expr": "(${A} > ${B})", "args": {"A": "float", "B": "float"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "GreaterEqual_DoubleDouble", "aliases": ["GreaterEqual_FloatFloat"], "pure": true, "expr": "(${A} >= ${B})", "args": {"A": "float", "B": "float"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "Less_DoubleDouble", "aliases": ["Less_FloatFloat"], "pure": true, "expr": "(${A} < ${B})", "args": {"A": "float", "B": "float"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "LessEqual_DoubleDouble", "aliases": ["LessEqual_FloatFloat"], "pure": true, "expr": "(${A} <= ${B})", "args": {"A": "float", "B": "float"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "EqualEqual_DoubleDouble", "aliases": ["EqualEqual_FloatFloat"], "pure": true, "expr": "(${A} == ${B})", "args": {"A": "float", "B": "float"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "NotEqual_DoubleDouble", "aliases": ["NotEqual_FloatFloat"], "pure": true, "expr": "(${A} != ${B})", "args": {"A": "float", "B": "float"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "NearlyEqual_FloatFloat", "pure": true, "expr": "(std::fabs(${A} - ${B}) <= ${ErrorTolerance})", "args": {"A": "float", "B": "float", "ErrorTolerance": "float"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "Greater_IntInt", "pure": true, "expr": "(${A} > ${B})", "args": {"A": "int", "B": "int"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "GreaterEqual_IntInt", "pure": true, "expr": "(${A} >= ${B})", "args": {"A": "int", "B": "int"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "Less_IntInt", "pure": true, "expr": "(${A} < ${B})", "args": {"A": "int", "B": "int"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "LessEqual_IntInt", "pure": true, "expr": "(${A} <= ${B})", "args": {"A": "int", "B": "int"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "EqualEqual_IntInt", "aliases": ["EqualEqual_ByteByte"], "pure": true, "expr": "(${A} == ${B})", "args": {"A": "int", "B": "int"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "NotEqual_IntInt", "aliases": ["NotEqual_ByteByte"], "pure": true, "expr": "(${A} != ${B})", "args": {"A": "int", "B": "int"}, "outTypes": {"ReturnValue": "bool"}},
    {"name": "BooleanAND", "pure": true, "op": "&&", "args": {"A": "bool", "B": "bool"}},
    {"name": "BooleanOR", "pure": true, "op": "||", "args": {"A": "bool", "B": "bool"}},
    {"name": "BooleanXOR", "pure": true, "expr": "(${A} != ${B})", "args": {"A": "bool", "B": "bool"}},
    {"name": "BooleanNAND", "pure": true, "expr": "!(${A} && ${B})", "args": {"A": "bool", "B": "bool"}},
    {"name": "BooleanNOR", "pure": true, "expr": "!(${A} || ${B})", "args": {"A": "bool", "B": "bool"}},
    {"name": "Not_PreBool", "pure": true, "expr": "!(${A})", "args": {"A": "bool"}},
    {"name": "EqualEqual_BoolBool", "pure": true, "expr": "(${A} == ${B})", "args": {"A": "bool", "B": "bool"}},
    {"name": "NotEqual_BoolBool", "pure": true, "expr": "(${A} != ${B})", "args": {"A": "bool", "B": "bool"}},
    {"name": "EqualEqual_ObjectObject", "pure": true, "expr": "(${A} == ${B})", "args": {"A": "entity", "B": "entity"}},
    {"name": "NotEqual_ObjectObject", "pure": true, "expr": "!(${A} == ${B})", "args": {"A": "entity", "B": "entity"}},
    {"name": "Abs", "pure": true, "expr": "std::fabs(${A})", "args": {"A": "float"}},
    {"name": "Abs_Int", "pure": true, "expr": "std::abs(${A})", "args": {"A": "int"}},
    {"name": "FMin", "pure": true, "expr": "std::min(${A}, ${B})", "args": {"A": "float", "B": "float"}},
    {"name": "FMax", "pure": true, "expr": "std::max(${A}, ${B})", "args": {"A": "float", "B": "float"}},
    {"name": "Min", "pure": true, "expr": "std::min(${A}, ${B})", "args": {"A": "int", "B": "int"}},
    {"name": "Max", "pure": true, "expr": "std::max(${A}, ${B})", "args": {"A": "int", "B": "int"}},
    {"name": "FClamp", "pure": true, "expr": "bp::FClamp(${Value}, ${Min}, ${Max})", "args": {"Value": "float", "Min": "float", "Max": "float"}},
    {"name": "Clamp", "pure": true, "expr": "bp::IClamp(${Value}, ${Min}, ${Max})", "args": {"Value": "int", "Min": "int", "Max": "int"}},
    {"name": "Lerp", "pure": true, "expr": "Lerp(${A}, ${B}, ${Alpha})", "args": {"A": "float", "B": "float", "Alpha": "float"}},
    {"name": "VLerp", "pure": true, "expr": "Vec3::Lerp(${A}, ${B}, ${Alpha})", "args": {"A": "vector", "B": "vector", "Alpha": "float"}},
    {"name": "FInterpTo", "pure": true, "expr": "bp::FInterpTo(${Current}, ${Target}, ${DeltaTime}, ${InterpSpeed})", "args": {"Current": "float", "Target": "float", "DeltaTime": "float", "InterpSpeed": "float"}},
